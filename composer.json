{
    "name": "easyswoole/queue",
    "description": "A simple Queue implementation integrated into easySwoole",
    "type": "library",
    "keywords": [
        "easySwoole",
        "Queue",
        "Redis",
        "RabbitMQ",
        "beanstalkd"
    ],
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "EasySwoole\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySwoole\\Queue\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-swoole": ">=5.1",
        "ext-redis": "*",
        "easyswoole/utility": "^1.4",
        "easyswoole/pool": "^3.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "easyswoole/swoole-ide-helper": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit"
    }
}
